APP_NAME="Metrik POS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


# Metrik POS backups (empty destination uses storage/app/private/backups)
# Prefer a protected off-device directory/volume for production.
METRIK_BACKUP_DIRECTORY=
METRIK_BACKUP_KEEP=14
METRIK_BACKUP_PATHS=storage/app/public,storage/app/private/report-exports
# Usually 'mysqldump'; if PHP cannot find it, configure its full path.
# XAMPP on Windows commonly uses C:/xampp/mysql/bin/mysqldump.exe.
METRIK_MYSQLDUMP_BINARY=mysqldump
METRIK_BACKUP_DUMP_TIMEOUT=300
METRIK_BACKUP_SCHEDULE=02:15
METRIK_BACKUP_MAX_AGE_HOURS=26
# Set a monitored address only after configuring a working mail transport.
# METRIK_BACKUP_ALERT_EMAIL=ops@example.com
